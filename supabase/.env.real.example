# Validação em Supabase REAL de DESENVOLVIMENTO (Etapa 3.3).
# Copie para supabase/.env.real (fora do Git) e preencha. Nunca use produção.
DG_ENV=development

# Project Settings > API
SUPABASE_URL=https://<ref-de-dev>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Papel postgres: só para o script montar o cenário fictício e inspecionar o catálogo
SUPABASE_DB_URL=postgresql://postgres:<senha>@db.<ref-de-dev>.supabase.co:5432/postgres

# Papel dg_worker, do jeito que o Fly.io vai conectar (direto ou pooler; a 3.3 confirma o formato)
DG_WORKER_DB_URL=postgresql://dg_worker:<senha>@db.<ref-de-dev>.supabase.co:5432/postgres
