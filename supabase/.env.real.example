# Validação em Supabase REAL de DESENVOLVIMENTO (Etapa 3.3).
# Copie para supabase/.env.real (fora do Git) e preencha. Nunca use produção.
DG_ENV=development

# Project Settings > API
SUPABASE_URL=https://<ref-de-dev>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Papel postgres: só para o script montar o cenário fictício e inspecionar o catálogo
SUPABASE_DB_URL=postgresql://postgres:<senha>@db.<ref-de-dev>.supabase.co:5432/postgres

# Papel dg_worker: é como o SERVIDOR do DG Brasil (API do computador do escritório,
# /api/executor/v1) fala com o banco. Use o POOLER (IPv4); o host direto
# db.<ref>.supabase.co é só IPv6 e falha em rede sem IPv6 (QA 5, ENV-01).
DG_WORKER_DB_URL=postgresql://dg_worker.<ref-de-dev>:<senha>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
