# Worker: conexão com o papel dg_worker (NUNCA postgres nem service role).
# Senha definida no projeto (ver supabase/README.md, "Papel do worker").
DATABASE_URL=postgresql://dg_worker:SENHA@db.PROJETO.supabase.co:5432/postgres

# Supabase (painel e Storage)
SUPABASE_URL=https://PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic — o worker usa esta chave para rodar os agentes
ANTHROPIC_API_KEY=

# Teto de gasto por execução de agente, em dólares (a versão do agente pode definir outro)
TETO_USD=2.00

# Fila: tentativas por execução; invisibilidade da mensagem (renovada pelo batimento
# enquanto o agente roda); batimento parado há mais que RESERVA_VENCIDA_SEGUNDOS = worker morto
MAX_TENTATIVAS=3
FILA_VT_SEGUNDOS=300
RESERVA_VENCIDA_SEGUNDOS=600

# Onde ficam os agentes e skills versionados do escritório
RAIZ_AGENTES=./agentes-claude
