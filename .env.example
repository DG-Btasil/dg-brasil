# ═══ Worker de agentes (apps/agentes) ═══════════════════════════════════════
# Valores reais: no DEV local, num .env fora do Git; no Fly.io, em `fly secrets`.
# NUNCA no navegador (nada de NEXT_PUBLIC_ com segredo), no log ou no banco.

# Conexão com o papel dg_worker (NUNCA postgres nem service role).
# Senha definida no projeto (ver supabase/README.md, "Papel do worker").
DATABASE_URL=postgresql://dg_worker:SENHA@db.PROJETO.supabase.co:5432/postgres

# Supabase. A service role do worker é usada SÓ para o Storage (baixar
# documentos/arquivos de skill e gravar minutas) — nunca para o banco.
SUPABASE_URL=https://PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude API (Console da Anthropic). Chave de API — assinatura Claude/Claude Code
# NÃO serve para isto. Recomendado: workspace exclusivo do DG Brasil DEV.
ANTHROPIC_API_KEY=

# Interruptor do processo: desligado por padrão. Além dele, o ADMIN liga a IA
# no DG Brasil (Configurações → IA). Os dois precisam estar ligados.
AI_EXECUTION_ENABLED=false

# Execuções simultâneas por worker (comece com 1).
WORKER_CONCURRENCY=1

# Teto de gasto por execução de agente, em dólares (a versão do agente pode definir outro).
TETO_USD=2.00

# Fila: tentativas por execução; invisibilidade da mensagem (renovada pelo batimento
# enquanto o agente roda); batimento parado há mais que RESERVA_VENCIDA_SEGUNDOS = worker morto
MAX_TENTATIVAS=3
FILA_VT_SEGUNDOS=300
RESERVA_VENCIDA_SEGUNDOS=600

# Provedor: novas tentativas do SDK em 429/5xx/rede e tempo máximo de uma chamada.
ANTHROPIC_MAX_RETRIES=2
ANTHROPIC_TIMEOUT_MS=600000

# Porta da verificação de saúde (GET /health). Não executa agente.
PORT=8080

# Smoke test pago contra o provedor real (npm run test:ai:real): só com
# AI_SMOKE_CONFIRMO=sim. SMOKE_MODEL padrão claude-haiku-5-5.
# AI_SMOKE_CONFIRMO=
# SMOKE_MODEL=claude-haiku-5-5
