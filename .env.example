# Banco (Supabase > Project Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres:SENHA@db.PROJETO.supabase.co:5432/postgres

# Supabase (painel e Storage)
SUPABASE_URL=https://PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic — o worker usa esta chave para rodar os agentes
ANTHROPIC_API_KEY=

# Teto de gasto por execução de agente, em dólares (a versão do agente pode definir outro)
TETO_USD=2.00

# Fila: tentativas por execução e segundos de invisibilidade da mensagem em processamento
MAX_TENTATIVAS=3
FILA_VT_SEGUNDOS=1800

# Onde ficam os agentes e skills versionados do escritório
RAIZ_AGENTES=./agentes-claude
