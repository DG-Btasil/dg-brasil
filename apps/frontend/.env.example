# DG Brasil — front-end (Next.js). Copie para .env.local e preencha.
# NUNCA commite .env.local. Use SOMENTE o projeto Supabase de DESENVOLVIMENTO.
#
# Em produção as variáveis ficam na Vercel (Settings → Environment Variables).
# A lista com o que é obrigatório, opcional ou proibido lá está em
# docs/deploy/producao.md, item 8. Na subida, o servidor confere e registra no
# log o que falta (src/server/core/env-check.ts).

# ── Ambiente ──────────────────────────────────────────────────────────────
# "development" aqui e no site de teste; "production" SÓ no uso real.
# Em produção: libera as chaves pagas do Serpro e desliga a demonstração dele.
DG_ENV=development

# ── Supabase (público: vai para o navegador) ──────────────────────────────
# URL e chave anon/publishable do projeto (Dashboard → Project Settings → API).
# A chave anon não dá acesso sozinha: quem decide é a RLS com o JWT do usuário.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO-DEV.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (SECRETO: só no servidor) ────────────────────────────────────
# Usada só onde a plataforma exige (inventário em docs/backend.md): Admin API
# do Auth (convite, redefinir MFA) e assinatura de URLs do Storage para um
# caminho que o banco já autorizou com o JWT do usuário. NUNCA use prefixo
# NEXT_PUBLIC_ nesta variável e nunca a importe em componente cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ── Conexão do servidor com o banco (login dg_worker) ─────────────────────
# Usada pela API do computador do escritório (/api/executor/v1), pela busca
# judicial, pelo Google Drive e pela rota /api/health. Login dg_worker (NUNCA
# postgres nem service role), pelo POOLER do Supabase (IPv4; em serverless, de
# preferência o de transação, porta 6543). Só no servidor. O computador do
# escritório NUNCA recebe esta URL: ele usa o token gerado em DG Brasil →
# Computador do escritório.
DG_WORKER_DB_URL=postgresql://dg_worker.SEU-REF:SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# ── Rotas agendadas (/api/cron/*) ─────────────────────────────────────────
# Texto aleatório longo (16 caracteres ou mais). A Vercel Cron e o agendador
# do banco mandam "Authorization: Bearer <CRON_SECRET>". Sem ela, as rotas
# agendadas respondem 401 e nada roda. Um valor por ambiente.
CRON_SECRET=

# ── Domínios (mesmo app, duas superfícies) ────────────────────────────────
# Só o nome do site, sem https://. Estes são os padrões do código.
# Em localhost não há redirecionamento entre superfícies: o papel decide.
NEXT_PUBLIC_APP_HOST=app.dgbrasil.adv.br
NEXT_PUBLIC_PORTAL_HOST=portal.dgbrasil.adv.br

# Origem dos links de e-mail quando o app roda num host que não é app./portal.
# nem localhost (ex.: preview). Precisa estar nas Redirect URLs do Supabase Auth.
# Em produção deve ficar AUSENTE.
# AUTH_FALLBACK_SITE_URL=https://preview.exemplo.dev

# ── Aviso de erros (opcional, recomendado em produção) ────────────────────
# Com um endereço aqui, todo erro que o servidor registra vira um POST para
# ele (já sem dado pessoal, no máximo 5 por minuto por instância). Serve um
# webhook de chat (Slack, Teams, Discord) ou de um serviço de alertas.
# docs/deploy/producao.md, "Monitoramento".
# ERROR_WEBHOOK_URL=https://hooks.exemplo.dev/servicos/XXXX

# ── Google Drive (opcional; docs/mcp/google-drive.md) ─────────────────────
# Jeito 1 (recomendado), conta do escritório por OAuth: as três juntas.
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# Jeito 2, conta de serviço (o JSON inteiro, ou ele em base64). Vence o jeito 1.
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# A pasta que contém as pastas dos clientes. Com ela, só pastas de dentro dela
# podem ser ligadas a um cliente.
# GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ── Integração judicial ───────────────────────────────────────────────────
# Opcional: o código já traz a chave pública do DataJud (wiki do CNJ). Só
# preencha se o CNJ trocar a chave e a tela mostrar "DataJud recusou a chave".
# DATAJUD_API_KEY=

# ── Limite de consultas por parceiro ──────────────────────────────────────
# Limite (best-effort, na aplicação) de consultas/cadastros por CPF/CNPJ feitos
# por parceiro, por minuto. Padrões: 10 por usuário, 30 por escritório.
# PARTNER_TAX_ID_LIMIT_PER_USER=10
# PARTNER_TAX_ID_LIMIT_PER_ORGANIZATION=30

# ── Demonstração ──────────────────────────────────────────────────────────
# Ferramentas da demonstração no menu do ADMIN ("Restaurar áreas de
# demonstração") e selo no cabeçalho. Desligado por padrão: as telas jurídicas
# leem o banco real; só "true" liga. Em produção deve ficar AUSENTE.
# NEXT_PUBLIC_DEMO_MODE=false

# ── Preenchimento automático do cadastro ──────────────────────────────────
# CEP (ViaCEP/BrasilAPI) e CNPJ (BrasilAPI) não precisam de chave.
# CPF → nome na Receita: API Consulta CPF do Serpro (paga por consulta;
# contrato do escritório). docs/deploy/producao.md, item 12.
#
# A tela só chama a consulta de CPF com esta variável em "1" (entra no build).
# NEXT_PUBLIC_CPF_LOOKUP=1
#
# Chaves PAGAS: só valem com DG_ENV=production. Não preencha fora da produção.
# SERPRO_CPF_CONSUMER_KEY=
# SERPRO_CPF_CONSUMER_SECRET=
# Opcional: outro endereço indicado pelo Serpro.
# SERPRO_CPF_BASE_URL=https://gateway.apiserpro.serpro.gov.br/consulta-cpf-df/v3
#
# Demonstração do Serpro (dados fictícios, sem custo), só FORA da produção:
# as duas juntas. Com DG_ENV=production elas são ignoradas.
# SERPRO_CPF_TRIAL=1
# SERPRO_CPF_TRIAL_TOKEN=
