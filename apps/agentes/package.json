{
  "name": "@dgbrasil/agentes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ai:real": "tsx --env-file-if-exists=.env src/smoke-real.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "pg": "^8.13.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
